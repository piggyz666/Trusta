# All amounts below are CNY minor units (fen).
TRUSTA_HIGH_RISK_CENTS=500000
# Set a private local sandbox secret to enable STRONG_AUTH transfers.
TRUSTA_STRONG_AUTH_SECRET=
# Optional. Otherwise generated and persisted locally in data/api.token.
TRUSTA_API_TOKEN=
# Optional absolute SQLite file path.
# TRUSTA_DB=D:/TRUSTA金融科技/data/trusta.sqlite3
# Finance read-only anomaly rules (fen / seconds).
TRUSTA_ANOMALY_LARGE_CENTS=100000
TRUSTA_ANOMALY_DUPLICATE_SECONDS=300
# Optional model-agnostic Gateway configuration. Unset means disabled (no inference).
# TRUSTA_LLM_CONFIG=D:/TRUSTA金融科技/config/llm.toml
# Set provider keys only in the environment, never in TOML or prompts.
# TRUSTA_PRIVATE_LLM_KEY=
# Normal local startup uses V3 ECDSA. V2 is explicit legacy compatibility only.
# After a database upgrades to V3, lowering this version is rejected.
TRUSTA_COMMUNICATION_VERSION=3
# Normal startup activates the six-agent Phase 5 banking profile; upgraded DBs cannot downgrade.
TRUSTA_BANKING_VERSION=5
# Optional private encrypted key-store directory; default is <database-name>.keys/.
# TRUSTA_CRYPTO_KEY_DIR=D:/TRUSTA金融科技/data/trusta.keys
# External Sepolia adapter is available, but requires separately configured RPC,
# deployed contract and a private TEST wallet; no silent fallback to local evidence.
# It never blocks bank execution; local development anchoring is the default.
TRUSTA_BLOCKCHAIN_ANCHOR_ENABLED=false
# First-version backend safety. CNY daily total >1000 yuan requires real TOTP.
TRUSTA_SAFETY_PROFILE=competition
TRUSTA_DAILY_TRANSFER_CENTS=100000
TRUSTA_AUTH_FAILURE_LIMIT=5
TRUSTA_EXECUTION_FAILURE_LIMIT=3
TRUSTA_SECURITY_OPERATOR_TOKEN=
TRUSTA_DID_ENABLED=true
# Optional development Groth16 assets. Build and pin your own manifest digest.
TRUSTA_ZKP_ENABLED=false
# TRUSTA_ZKP_ARTIFACT_DIR=D:/TRUSTA金融科技/data/zkp-dev-v1
# TRUSTA_ZKP_MANIFEST_SHA256=<digest printed by the local builder>
