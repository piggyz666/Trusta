# Copy these entries into the repository-root .env (already Git-ignored).
# No quotes. RPC URL is secret; never commit it or paste it into chat.
ANCHOR_RPC_URL=
# PUBLIC 0x address of the wallet that will deploy and publish. No private key needed.
ANCHOR_WALLET_ADDRESS=
# Optional second independently operated RPC for later independent acceptance.
ANCHOR_VERIFY_RPC_URL=
# Do not enable the external worker for gas estimation.
TRUSTA_BLOCKCHAIN_ANCHOR_ENABLED=false
# Local encrypted Web3 keystore. Keep outside the repository. No private key in chat.
ANCHOR_KEYSTORE_PATH=
# Set ANCHOR_KEYSTORE_PASSWORD only in the operator's local process, not this template.
# Pin the exact publisher-patched runtime code hash from readiness output after deployment.
ANCHOR_CONTRACT_CODE_HASH=
# Always disabled until a specific, freshly quoted transaction is approved.
ANCHOR_ALLOW_SIGNING=false
ANCHOR_ALLOW_BROADCAST=false
ANCHOR_APPROVED_PLAN_HASH=
