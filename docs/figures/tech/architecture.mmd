flowchart TB
  subgraph CH["渠道（统一会话服务，同一套授权规则）"]
    W["网页 / 手机 H5"]; F["飞书机器人"]; C["终端 / HTTP API"]
  end
  subgraph CL["对话层 backend/chat"]
    G["① 输入防护<br/>注入 · 诈骗话术 · 敏感探测"]
    U["② 意图理解<br/>大模型工具调用 ↔ 规则引擎兜底<br/>（熔断：60 秒内失败 3 次切规则）"]
    V["③ 校验器<br/>金额 / 收款人须出自原话<br/>授权字段 → 整轮作废"]
    R["功能注册表<br/>按银行能力点亮工具"]
    Q["④ 计划与卡片<br/>DAG · 确认卡 · 查询确认卡"]
  end
  subgraph RT["六智能体运行时 backend/runtime + agents"]
    SUP["Supervisor"]; PL["Planner"]; TR["Transaction"]; FI["Finance"]; WE["Wealth"]; SV["Service"]
  end
  subgraph SEC["安全执行链"]
    P["策略引擎<br/>绿 / 黄 / 红"]; A["授权<br/>确认卡 + 刷脸·指纹 / 动态码 / 短信"]
    X["执行合约<br/>前置条件 · 幂等键"]; GW["工具网关<br/>能力白名单"]
    HV["独立核验"]; RC["签名回执"]
  end
  subgraph BK["银行接入层 backend/bank_sdk"]
    SDK["规范接口<br/>BankRequest → BankResponse"]
    VB["内置沙箱银行"]; RV["Revolut 沙箱（已实测）"]; PB["任意银行适配器<br/>provider = module"]
  end
  AU[("审计哈希链<br/>Merkle 检查点")]
  W & F & C --> G --> U --> V --> Q
  R -.-> U & V
  Q -->|签名消息 ECDSA P-256| SUP --> PL --> TR & FI & WE & SV
  TR & FI & WE & SV -->|提议 BankActionIR| P --> A --> X --> GW --> SDK
  SDK --> VB & RV & PB
  GW --> HV --> RC
  P & A & X & HV & RC -.-> AU
